{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deshell.dev/schema/effect-ir/v3",
  "title": "de-shell Effect IR",
  "type": "object",
  "required": ["schema_version", "generator", "entrypoint", "tasks"],
  "properties": {
    "schema_version": { "const": 3 },
    "generator": { "type": "string", "minLength": 1 },
    "entrypoint": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "valueType": {
      "oneOf": [
        {
          "enum": ["bytes", "text", "bool", "int", "path", "byte_stream"]
        },
        {
          "type": "object",
          "required": ["list"],
          "properties": { "list": { "$ref": "#/$defs/valueType" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["record"],
          "properties": {
            "record": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/valueType" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["secret"],
          "properties": { "secret": { "$ref": "#/$defs/valueType" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["object_stream"],
          "properties": {
            "object_stream": { "$ref": "#/$defs/valueType" }
          },
          "additionalProperties": false
        }
      ]
    },
    "scalarValueType": {
      "oneOf": [
        {
          "enum": ["bytes", "text", "bool", "int", "path"]
        },
        {
          "type": "object",
          "required": ["secret"],
          "properties": {
            "secret": { "$ref": "#/$defs/scalarValueType" }
          },
          "additionalProperties": false
        }
      ]
    },
    "binding": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/valueType" }
      },
      "additionalProperties": true
    },
    "span": {
      "type": "object",
      "required": [
        "file",
        "start_line",
        "start_column",
        "end_line",
        "end_column",
        "start_byte",
        "end_byte"
      ],
      "properties": {
        "file": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 0 },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "guarantee": {
      "oneOf": [
        {
          "type": "object",
          "required": ["level", "basis"],
          "properties": {
            "level": { "const": "formal" },
            "basis": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["level", "scenarios"],
          "properties": {
            "level": { "const": "exhaustive" },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["level", "scenarios", "observation_digest"],
          "properties": {
            "level": { "const": "differential" },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "observation_digest": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["level", "reason"],
          "properties": {
            "level": { "const": "residual" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      ]
    },
    "node": {
      "type": "object",
      "required": ["id", "operation", "guarantee", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/operation" },
        "guarantee": { "$ref": "#/$defs/guarantee" },
        "source": {
          "oneOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }]
        }
      },
      "additionalProperties": true
    },
    "nodeArrayOperation": {
      "type": "object",
      "required": ["type", "nodes"],
      "properties": {
        "type": { "enum": ["pipeline", "sequence", "parallel"] },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": true
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "argv"],
          "properties": {
            "type": { "const": "exec" },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "environment": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "working_directory": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": true
        },
        { "$ref": "#/$defs/nodeArrayOperation" },
        {
          "type": "object",
          "required": ["type", "predicate", "if_true"],
          "properties": {
            "type": { "const": "condition" },
            "predicate": { "$ref": "#/$defs/node" },
            "if_true": { "$ref": "#/$defs/node" },
            "if_false": {
              "oneOf": [{ "$ref": "#/$defs/node" }, { "type": "null" }]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "value", "cases"],
          "properties": {
            "type": { "const": "match" },
            "value": { "type": "string" },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "body"],
                "properties": {
                  "pattern": { "type": "string" },
                  "body": { "$ref": "#/$defs/node" }
                }
              }
            },
            "default": {
              "oneOf": [{ "$ref": "#/$defs/node" }, { "type": "null" }]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "variable", "items", "body"],
          "properties": {
            "type": { "const": "foreach" },
            "variable": { "type": "string", "minLength": 1 },
            "items": { "type": "array", "items": { "type": "string" } },
            "body": { "$ref": "#/$defs/node" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "body", "finalizer"],
          "properties": {
            "type": { "const": "try_finally" },
            "body": { "$ref": "#/$defs/node" },
            "finalizer": { "$ref": "#/$defs/node" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "task"],
          "properties": {
            "type": { "const": "task_call" },
            "task": { "type": "string", "minLength": 1 },
            "arguments": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "name", "value_type", "value"],
          "properties": {
            "type": { "const": "set_variable" },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "value_type": { "$ref": "#/$defs/scalarValueType" },
            "value": { "type": "string" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "name", "value_type", "body"],
          "properties": {
            "type": { "const": "capture_stdout" },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "value_type": { "const": "text" },
            "body": { "$ref": "#/$defs/node" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "enum": ["file_read", "file_remove"] },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "path", "contents", "append"],
          "properties": {
            "type": { "const": "file_write" },
            "path": { "type": "string", "minLength": 1 },
            "contents": { "type": "string" },
            "append": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "method", "uri"],
          "properties": {
            "type": { "const": "network_request" },
            "method": { "type": "string", "minLength": 1 },
            "uri": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "interpreter", "source", "reason"],
          "properties": {
            "type": { "const": "opaque_capsule" },
            "interpreter": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "path": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "invocationValidation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "allow_empty_string" } },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "not_null_or_empty" } },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind", "values", "ignore_case"],
          "properties": {
            "kind": { "const": "string_set" },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "ignore_case": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind", "minimum", "maximum"],
          "properties": {
            "kind": { "const": "int_range" },
            "minimum": { "type": "integer" },
            "maximum": { "type": "integer" }
          },
          "additionalProperties": true
        }
      ]
    },
    "invocationParameter": {
      "type": "object",
      "required": [
        "input",
        "position",
        "required",
        "switch",
        "default",
        "validations"
      ],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "position": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "required": { "type": "boolean" },
        "switch": { "type": "boolean" },
        "default": { "type": ["string", "null"] },
        "validations": {
          "type": "array",
          "items": { "$ref": "#/$defs/invocationValidation" }
        }
      },
      "additionalProperties": true
    },
    "invocation": {
      "type": "object",
      "required": ["style", "accepts_common_parameters", "parameters"],
      "properties": {
        "style": { "const": "powershell" },
        "accepts_common_parameters": { "type": "boolean" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/invocationParameter" }
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": [
        "name",
        "inputs",
        "outputs",
        "environment",
        "secrets",
        "platform_capabilities",
        "cacheable",
        "invocation",
        "body"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
        "environment": { "type": "array", "items": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "platform_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cacheable": { "type": "boolean" },
        "invocation": {
          "oneOf": [
            { "$ref": "#/$defs/invocation" },
            { "type": "null" }
          ]
        },
        "body": { "$ref": "#/$defs/node" }
      },
      "additionalProperties": true
    }
  }
}
