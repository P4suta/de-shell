{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deshell.dev/schema/evidence/v1",
  "title": "de-shell Evidence",
  "type": "object",
  "required": ["schema_version", "plan_digest", "source", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": ["path", "content_hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "operation", "guarantee"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "guarantee": {
            "$ref": "effect-ir.schema.json#/$defs/guarantee"
          }
        },
        "additionalProperties": true
      }
    },
    "observation": {
      "type": "object",
      "required": ["requested", "status", "provider", "reason"],
      "properties": {
        "requested": { "const": true },
        "status": {
          "enum": ["verified", "different", "unavailable", "failed"]
        },
        "provider": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["verified", "different"] }
            }
          },
          "then": { "required": ["digest", "scenarios"] }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
