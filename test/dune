; This fixture is spawned directly by Adapter_client.  Keep it native on Windows,
; where a bytecode image is not itself a directly executable process.

(executable
 (name test_adapter_process_fixture)
 (modules test_adapter_process_fixture)
 (libraries deshell yojson unix))

(rule
 (alias fast)
 (action
  (progn
   (run %{exe:test_ir.bc})
   (run %{exe:test_frontend.bc})
   (run %{exe:test_frontend_registry.bc})
   (run %{exe:test_rewrite.bc})
   (run %{exe:test_modernizer.bc})
   (run %{exe:test_command_model.bc})
   (run %{exe:test_lockfile.bc})
   (run %{exe:test_synthesizer.bc})
   (run %{exe:test_release_gate.bc})
   (run %{exe:test_project_config.bc})
