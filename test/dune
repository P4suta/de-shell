   (run %{exe:test_scenario.bc})
   (run %{exe:test_observation.bc})
   (run %{exe:test_replay.bc})
   (run %{exe:test_template.bc})
   (run %{exe:test_runner.bc})
   (run %{exe:test_properties.bc}))))

(rule
 (alias contract)
 (deps
  %{bin:deshell}
  %{bin:deshell-observer-agent}
  %{bin:deshell-process-agent}
  ../.editorconfig
  ../.gitattributes
  ../CITATION.cff
  ../CHANGELOG.md
  ../CODE_OF_CONDUCT.md
  ../GOVERNANCE.md
  ../mise.lock
  ../mise.toml
  ../SECURITY.md
  ../SUPPORT.md
  ../.github/CODEOWNERS
  ../.github/dependabot.yml
  ../.github/pull_request_template.md
  ../.github/release.yml
  ../.github/ISSUE_TEMPLATE/bug_report.yml
  ../.github/ISSUE_TEMPLATE/feature_request.yml
  ../.github/ISSUE_TEMPLATE/config.yml
  ../.github/workflows/ci.yml
  ../.github/workflows/dependency-review.yml
  ../.github/workflows/scorecard.yml
  ../.github/rulesets/default-branch.json
  ../.github/rulesets/release-tags.json
  ../.github/settings/repository.json
  ../.github/settings/capabilities.json
  ../.github/settings/topics.json
  ../.github/settings/actions.json
  ../.github/settings/selected-actions.json
  ../.github/settings/workflow-permissions.json
  ../.github/settings/fork-approval.json
  ../.github/settings/features.json
  ../.github/settings/labels.json
  ../adapters/nushell/dune
  ../scripts/github-repository.ps1
  ../scripts/repository-guardrails.ps1
  ../scripts/validate-official-exporters.ps1
  test_repository_guardrails.ps1
  ../schema/effect-ir.schema.json
  ../schema/evidence.schema.json
  ../schema/adapter.schema.json)
 (action
  (progn
   (run %{exe:test_protocol.bc})
   (run %{exe:test_adapter_client.bc})
   (setenv
    DESHELL_TEST_ADAPTER_EXE
    %{exe:test_adapter_process_fixture.exe}
    (run %{exe:test_adapter_process.bc}))
   (setenv
    DESHELL_POWERSHELL_ADAPTER
    %{dep:../adapters/powershell/adapter.ps1}
    (run %{exe:test_powershell_adapter.bc}))
   (setenv
    DESHELL_TEST_AGENT_EXE
    %{bin:deshell-observer-agent}
    (run %{exe:test_observer_cli.bc}))
   (setenv
    DESHELL_SCHEMA_DIR
    ../schema
    (run %{exe:test_schema.bc}))
   (setenv
    DESHELL_REPOSITORY_ROOT
    %{workspace_root}
    (run %{exe:test_repository_policy.bc}))
   (run
    pwsh
    -NoLogo
    -NoProfile
    -File
    %{dep:test_repository_guardrails.ps1}
    -GuardrailScript
    %{dep:../scripts/repository-guardrails.ps1})
   (run %{exe:test_exporter.bc})
   (setenv
    DESHELL_PROCESS_AGENT
    %{bin:deshell-process-agent}
    (setenv
     DESHELL_OBSERVER_PROVIDER
     none
     (setenv
      DESHELL_TEST_EXE
      %{bin:deshell}
      (run %{exe:test_cli.bc})))))))

(rule
 (alias platform)
 (deps %{bin:deshell-process-agent})
 (action
