{
  "$id": "https://deshell.dev/contracts/protocol/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "deshell.stream" },
        "params": {
          "additionalProperties": false,
          "properties": {
            "data_base64": {
              "contentEncoding": "base64",
              "maxLength": 349528,
              "type": "string"
            },
            "request_id": { "type": ["integer", "string"] },
            "sequence": { "minimum": 0, "type": "integer" },
            "stream": { "enum": ["stdout", "stderr"] }
          },
          "required": ["data_base64", "request_id", "sequence", "stream"],
          "type": "object"
        }
      },
      "required": ["jsonrpc", "method", "params"],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "properties": {
        "id": { "type": ["integer", "string"] },
        "jsonrpc": { "const": "2.0" },
        "method": { "minLength": 1, "type": "string" },
        "params": { "additionalProperties": true, "type": "object" }
      },
      "required": ["jsonrpc", "id", "method", "params"],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "oneOf": [{ "required": ["result"] }, { "required": ["error"] }],
      "properties": {
        "error": {
          "additionalProperties": true,
          "properties": {
            "code": { "type": "integer" },
            "data": true,
            "message": { "type": "string" }
          },
          "required": ["code", "message"],
          "type": "object"
        },
        "id": { "type": ["integer", "string", "null"] },
        "jsonrpc": { "const": "2.0" },
        "result": { "additionalProperties": true, "type": "object" }
      },
      "required": ["jsonrpc", "id"],
      "type": "object"
    }
  ],
  "title": "de-shell JSON-RPC v1 envelope"
}
