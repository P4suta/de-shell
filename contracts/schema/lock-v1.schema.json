{
  "$id": "https://deshell.dev/contracts/lock/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapters": {
      "additionalProperties": false,
      "properties": {
        "nushell": { "$ref": "#/$defs/pin" },
        "powershell": { "$ref": "#/$defs/pin" }
      },
      "required": ["powershell", "nushell"],
      "type": "object"
    },
    "artifacts": {
      "additionalProperties": false,
      "properties": { "command_model": { "$ref": "#/$defs/pin" } },
      "required": ["command_model"],
      "type": "object"
    },
    "interpreters": {
      "additionalProperties": false,
      "properties": {
        "bash": { "$ref": "#/$defs/pin" },
        "cmd": { "$ref": "#/$defs/pin" },
        "fish": { "$ref": "#/$defs/pin" },
        "nushell": { "$ref": "#/$defs/pin" },
        "posix_sh": { "$ref": "#/$defs/pin" },
        "powershell": { "$ref": "#/$defs/pin" },
        "zsh": { "$ref": "#/$defs/pin" }
      },
      "required": ["posix_sh", "bash", "zsh", "fish", "powershell", "cmd", "nushell"],
      "type": "object"
    },
    "lab": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "architecture": { "enum": ["aarch64", "x86_64"] },
              "executable": { "type": "boolean" },
              "name": { "pattern": "^[A-Za-z0-9._-]+$", "type": "string" },
              "operating_system": { "enum": ["linux", "macos", "windows"] },
              "path": { "$ref": "#/$defs/path" },
              "role": { "enum": ["helper", "runtime"] },
              "sha256": { "$ref": "#/$defs/pin" }
            },
            "required": ["name", "role", "operating_system", "architecture", "path", "sha256", "executable"],
            "type": "object"
          },
          "type": "array"
        },
        "image": { "$ref": "#/$defs/imagePin" }
      },
      "required": ["image", "assets"],
      "type": "object"
    },
    "protocol": {
      "additionalProperties": false,
      "properties": {
        "effect_ir": { "const": 1 },
        "evidence": { "const": 1 },
        "json_rpc": { "const": 1 }
      },
      "required": ["json_rpc", "effect_ir", "evidence"],
      "type": "object"
    },
    "toolchain": {
      "additionalProperties": false,
      "properties": { "rust": { "const": "1.98.0" } },
      "required": ["rust"],
      "type": "object"
    },
    "targets": {
      "additionalProperties": false,
      "properties": { "dagger_image": { "$ref": "#/$defs/imagePin" } },
      "required": ["dagger_image"],
      "type": "object"
    },
    "version": { "const": 1 }
  },
  "required": ["version", "toolchain", "protocol", "artifacts", "adapters", "interpreters", "targets", "lab"],
  "title": "de-shell lock file v1",
  "type": "object",
  "$defs": {
    "path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/\\.{1,2}(?:/|$))(?!.*\\/$)[^\\\\:\\u0000]+$",
      "type": "string"
    },
    "pin": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "imagePin": {
      "anyOf": [
        { "const": "unconfigured" },
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9/._:-]*@sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    }
  }
}
