opam-version: "2.0"
name: "de-shell"
version: "0.1.0"
synopsis: "Behavioral compiler for migrating shell automation"
description: """
de-shell inventories shell automation, lowers supported behavior into a typed
Effect IR, and preserves unsupported behavior in executable residual capsules.
"""
maintainer: ["de-shell contributors"]
authors: ["de-shell contributors"]
license: "Apache-2.0"
homepage: "https://github.com/P4suta/de-shell"
bug-reports: "https://github.com/P4suta/de-shell/issues"
dev-repo: "git+https://github.com/P4suta/de-shell.git"
depends: [
  "ocaml" {>= "5.5.0" & < "5.6"}
  "dune" {>= "3.24" & < "3.25"}
  "cmdliner" {>= "1.3.0"}
  "yojson" {>= "2.2.0"}
  "conf-rust"
  "alcotest" {with-test}
  "qcheck" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
