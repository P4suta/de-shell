opam-version: "2.0"
name: "de-shell"
version: "0.1.0"
synopsis: "Unpublished OCaml Effect IR v1 reference"
description: """\
Private deterministic reference used to compare the shared Effect IR v1 golden
corpus with the public Rust deshell implementation. This package is not shipped."""
maintainer: "de-shell contributors"
authors: "de-shell contributors"
license: "Apache-2.0"
homepage: "https://github.com/P4suta/de-shell"
bug-reports: "https://github.com/P4suta/de-shell/issues"
dev-repo: "git+https://github.com/P4suta/de-shell.git"
depends: [
  "dune" {= "3.24.2"}
  "ocaml" {= "5.5.0"}
  "ocamlformat" {= "0.29.0" & with-dev-setup & = "0.29.0"}
  "yojson" {= "3.0.0"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "@reference-v1" "-j" jobs]
]
